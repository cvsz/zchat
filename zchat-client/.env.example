# Second Account Verification
ZCHAT_VERIFICATION_ENABLED=false
ZCHAT_VERIFICATION_ROLE=primary
ZCHAT_VERIFICATION_TARGET_ACCOUNT=
ZCHAT_VERIFICATION_RUN_TIMEOUT_SECONDS=60
ZCHAT_VERIFICATION_POLL_INTERVAL_SECONDS=3

# Evidence
ZCHAT_EVIDENCE_ENABLED=true
ZCHAT_EVIDENCE_DIR=./evidence
ZCHAT_EVIDENCE_RETENTION_DAYS=14
ZCHAT_EVIDENCE_SCREENSHOTS=true
ZCHAT_EVIDENCE_REDACT_PII=true

# Secure Observer Transport
ZCHAT_OBSERVER_HOST=127.0.0.1
ZCHAT_OBSERVER_PORT=8765
ZCHAT_OBSERVER_TLS_ENABLED=true
