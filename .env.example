# Copy to .env for local development and customize safely.
# Never commit real credentials or production secrets.

APP_ENV=production
APP_PORT=3000
LOG_LEVEL=info

# Real / live acceptance environment (operator-supplied; see docs/VERIFICATION-E2E-WINDOWS.md).
# Replace every placeholder below with the real operator value before a live run.
CAMFROG_APP_PROFILE=full
CAMFROG_APP_DATA_DIR=
CAMFROG_PRESENCE_DATA_DIR=
CAMFROG_USER=
CAMFROG_PASSWORD=
CAMFROG_BOT_USER=
CAMFROG_BOT_PASSWORD=
CAMFROG_ROOM=
CAMFROG_WINDOWS_HOST=windows.example
CAMFROG_WINDOWS_USER=
CAMFROG_WINDOWS_DIR=
CAMFROG_WINDOWS_PYTHON=.venv/Scripts/python.exe
CAMFROG_SSH_CONTROL_SOCKET=

# Web session cookies (Account A / bot). Format: PHPSESSID=<value>
WEBAUTH_USER=
WEBAUTH_BOT_USER=

# Optional model provider.
QWEN_API_KEY=
QWEN_API_ENDPOINT=

# ZChat runtime switches.
ZCHAT_USER_IDLE_MS=2000
ZCHAT_EMERGENCY_STOP_DB=
ZCFATO_DATA_DIR=
ZCFATO_STATUS_MODE=App
ZCFATO_WORKER_START_GATE=
ZCODER_CERT_THUMBPRINT=

